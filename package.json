{
  "name": "vahan-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/electron.cjs",
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "vite build",
    "preview": "vite preview",
    "dist": "npm run build && cd backend && call build_backend.bat && cd .. && set WIN_CSC_LINK=cert.pfx && set WIN_CSC_KEY_PASSWORD=password && npx electron-builder --win nsis --x64"
  },
  "build": {
    "appId": "com.vahan.dashboard",
    "productName": "Vahan Dashboard",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": "dist_backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis"
    }
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "vite": "^5.2.0"
  }
}
